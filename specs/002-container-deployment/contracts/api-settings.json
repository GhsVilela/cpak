{
  "openapi": "3.0.0",
  "info": {
    "title": "CPAK Settings API",
    "description": "API endpoints for managing application settings through the UI",
    "version": "1.0.0"
  },
  "paths": {
    "/api/settings": {
      "get": {
        "summary": "List all settings",
        "description": "Retrieve all settings or filter by category. Secret values are masked.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "Filter settings by category",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["platform_api", "scheduler", "sync", "system"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "settings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SettingResponse"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/{key}": {
      "get": {
        "summary": "Get specific setting",
        "description": "Retrieve a single setting by key. Secret values return hasValue only.",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Setting details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Setting not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update or create setting",
        "description": "Set a configuration value. Creates if doesn't exist.",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Setting updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete setting",
        "description": "Remove a setting. Application will fall back to environment variable or default.",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z_]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Setting deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Setting deleted, will use default value"
                    },
                    "key": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Setting not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SettingResponse": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Setting identifier",
            "pattern": "^[a-z_]+$",
            "example": "steam_api_key"
          },
          "value": {
            "type": "string",
            "description": "Setting value. Masked as '***hidden***' for secrets.",
            "example": "***hidden***"
          },
          "category": {
            "type": "string",
            "enum": ["platform_api", "scheduler", "sync", "system"],
            "description": "Setting category"
          },
          "isSecret": {
            "type": "boolean",
            "description": "Whether value is encrypted"
          },
          "hasValue": {
            "type": "boolean",
            "description": "Indicates if a value is set (useful for secrets)"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last modification timestamp"
          }
        },
        "required": ["key", "category", "isSecret", "hasValue"]
      },
      "SettingUpdate": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "New setting value",
            "maxLength": 2048
          },
          "category": {
            "type": "string",
            "enum": ["platform_api", "scheduler", "sync", "system"],
            "description": "Setting category"
          },
          "isSecret": {
            "type": "boolean",
            "description": "Whether value should be encrypted",
            "default": false
          }
        },
        "required": ["value", "category"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "code": {
            "type": "string",
            "description": "Error code"
          }
        }
      }
    }
  }
}
