{
	# Global options
	admin off
	log {
		output stdout
		format json
		level INFO
	}
}

# HTTPS on port 443 - self-signed certificate via Caddy internal CA.
# Caddy automatically provisions a cert from its built-in CA and enables TLS.
# It also creates an internal HTTP→HTTPS redirect listener on :80 which is
# harmless if the host doesn’t map port 80.
:443 {
	tls internal

	# API routes proxy to backend
	handle /api/* {
		reverse_proxy localhost:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# Health check endpoint
	handle /health {
		reverse_proxy localhost:8080
	}

	# Frontend routes proxy to Next.js
	handle {
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# Enable gzip compression
	encode gzip

	# Logging
	log {
		output stdout
		format json
	}
}
